{% extends '@SolidInvoiceUser/Security/layout.html.twig' %}

{% block page_title %}{{ app_name }} - {{ 'forgot_password.request.title'|trans }}{% endblock page_title %}

{% block auth_content %}
    <twig:Ui:AuthCard title="{{ 'forgot_password.request.heading'|trans }}" description="{{ 'forgot_password.request.description'|trans }}">
        {{ form_start(form) }}
            {{ form_errors(form) }}

            {{ form_row(form.email, {label: 'forgot_password.request.username'}) }}

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">
                    {{ ux_icon('tabler:mail', {class: 'icon'}) }}
                    {{ 'forgot_password.request.submit'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </twig:Ui:AuthCard>

    <div class="text-center text-secondary mt-3 bg-white p-2">
        <a href="{{ path(login_route) }}">{{ 'forgot_password.request.back_to_login'|trans }}</a>
    </div>
{% endblock auth_content %}
