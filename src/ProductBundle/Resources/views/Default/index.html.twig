{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:package', {width: 24, height: 24, class: 'me-2'}) }}
    {{ 'product.title'|trans }}
{% endblock title %}

{% block page_title %}
    <div class="col">
        <h1 class="page-title">{{ 'product.title'|trans }}</h1>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <a class="btn btn-primary" href="{{ path('_products_add') }}">
            {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
            {{ 'product.add'|trans }}
        </a>
    </div>
{% endblock %}


{% block content %}
    <twig:Ui:Card>
        <twig:DataGrid name="product_grid" />
    </twig:Ui:Card>
{% endblock %}

