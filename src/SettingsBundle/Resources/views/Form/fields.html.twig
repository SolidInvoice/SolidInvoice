{% extends '@SolidInvoiceCore/Form/fields.html.twig' %}

{# Settings-specific checkbox styling - uses settings CSS classes #}
{% block checkbox_row %}
    {% set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' settings-toggle-field')|trim}) %}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        <div class="form-check form-switch settings-switch">
            {{- form_widget(form) -}}
            {{- form_label(form) -}}
        </div>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock checkbox_row %}

{% block checkbox_label %}
    <label class="form-check-label settings-switch-label" for="{{ id }}">
        {% if label is not same as(false) %}
            {{ label|default(name|humanize)|replace({'_': ' '})|title|trans }}
        {% endif %}
    </label>
{% endblock checkbox_label %}

{# Settings Address Widget - improved layout #}
{% block settings_address_widget %}
    <div class="settings-address-group card bg-light border-0">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-12">
                    {{ form_row(form.street1, {label: 'Street Address'|trans, attr: {placeholder: 'Street address line 1'|trans}}) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.street2, {label: 'Street Address 2'|trans, attr: {placeholder: 'Apartment, suite, unit, etc. (optional)'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.city, {label: 'City'|trans, attr: {placeholder: 'City'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.state, {label: 'State / Province'|trans, attr: {placeholder: 'State or province'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.zip, {label: 'Postal Code'|trans, attr: {placeholder: 'ZIP / Postal code'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.country, {label: 'Country'|trans}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock settings_address_widget %}

{# Image Upload Widget - clean logo upload with preview #}
{% block image_upload_widget %}
    <div class="logo-upload-card d-flex align-items-center gap-4 p-3 bg-light rounded-3">
        <div class="logo-upload-preview flex-shrink-0">
            <div class="logo-preview-frame">
                {{ app_logo(width=72, showDefault=false) }}
            </div>
        </div>
        <div class="logo-upload-dropzone flex-grow-1">
            <div class="dropzone-wrapper">
                {{ block('dropzone_widget') }}
            </div>
            <p class="text-muted small mt-2 mb-0">
                {{ 'Recommended: Square image, at least 200x200px. PNG or JPG format.'|trans }}
            </p>
        </div>
    </div>
{% endblock image_upload_widget %}

{# Mail Transport Type - enhanced layout #}
{% block mail_transport_widget %}
    <div class="mail-transport-settings" {{ stimulus_controller('mailsettings') }}>
        {% for child in form %}
            {% if child.vars.name == 'provider' %}
                <div class="mail-provider-select mb-3">
                    {{ form_row(child) }}
                </div>
            {% else %}
                <div class="mail-provider-config {{ child.vars.row_attr.class|default('') }}"
                     data-provider="{{ child.vars.name }}">
                    <div class="card bg-light border-0 mt-3">
                        <div class="card-body">
                            {{ form_widget(child) }}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endblock mail_transport_widget %}
