{% extends '@SolidInvoiceCore/Form/fields.html.twig' %}

{#
 # Compact upgrade badge — clickable link to the SaaS plan picker / checkout that
 # carries the plan name as both the visible label and the hover tooltip. Used in
 # place of the previous static "Subscription Required" badge + bulky form-hint.
 #}
{% macro feature_gated_badge(plan) %}
    <a href="{{ path('saas_subscription_plans') }}"
       class="badge bg-azure-lt text-decoration-none text-azure"
       title="{{ plan
            ? 'settings.upgrade.tooltip_plan'|trans({'%plan%': plan})
            : 'settings.upgrade.tooltip'|trans }}">
        {{ ux_icon('tabler:arrow-up-circle', {width: 14, height: 14, class: 'me-1'}) }}
        {%- if plan -%}
            {{ 'settings.upgrade.label_plan'|trans({'%plan%': plan}) }}
        {%- else -%}
            {{ 'settings.upgrade.label'|trans }}
        {%- endif -%}
    </a>
{% endmacro %}

{% macro trial_restricted_badge() %}
    <a href="{{ path('saas_subscription_checkout') }}"
       class="badge bg-azure-lt text-decoration-none text-azure"
       title="{{ 'settings.upgrade.activate_tooltip'|trans }}">
        {{ ux_icon('tabler:arrow-up-circle', {width: 14, height: 14, class: 'me-1'}) }}
        {{ 'settings.upgrade.activate'|trans }}
    </a>
{% endmacro %}

{# Trial-Restricted Form Row #}
{% block checkbox_row %}
    {% import _self as upgrade %}
    {% if feature_gated_active|default(false) and toggle('saas_enabled') %}
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">{{ label|trans }}</label>
                {{ upgrade.feature_gated_badge(feature_gated_plan|default(null)) }}
            </div>

            {# Suppress the inner switch label to avoid duplicate-label visual #}
            {{ form_widget(form, {parent_label_class: 'checkbox-switch', label: false}) }}
            {{ form_help(form) }}
            {{ form_errors(form) }}
        </div>
    {% elseif trial_restricted_active|default(false) and toggle('saas_enabled') %}
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">{{ label|trans }}</label>
                {{ upgrade.trial_restricted_badge() }}
            </div>

            {# Suppress the inner switch label to avoid duplicate-label visual #}
            {{ form_widget(form, {parent_label_class: 'checkbox-switch', label: false}) }}
            {{ form_help(form) }}
            {{ form_errors(form) }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block form_row %}
    {% import _self as upgrade %}
    {% if feature_gated_active|default(false) and toggle('saas_enabled') %}
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label">{{ label|trans }}</label>
                {{ upgrade.feature_gated_badge(feature_gated_plan|default(null)) }}
            </div>

            {{ form_widget(form) }}
        </div>
    {% elseif trial_restricted_active|default(false) and toggle('saas_enabled') %}
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label">{{ label|trans }}</label>
                {{ upgrade.trial_restricted_badge() }}
            </div>

            {{ form_widget(form) }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Settings Address Widget - improved layout with Bootstrap grid #}
{% block settings_address_widget %}
    <div class="card bg-light border-0">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-12">
                    {{ form_row(form.street1, {label: 'settings.address.street1'|trans, attr: {placeholder: 'settings.address.street1_placeholder'|trans}}) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.street2, {label: 'settings.address.street2'|trans, attr: {placeholder: 'settings.address.street2_placeholder'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.city, {label: 'settings.address.city'|trans, attr: {placeholder: 'settings.address.city_placeholder'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.state, {label: 'settings.address.state'|trans, attr: {placeholder: 'settings.address.state_placeholder'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.zip, {label: 'settings.address.zip'|trans, attr: {placeholder: 'settings.address.zip_placeholder'|trans}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.country, {label: 'settings.address.country'|trans}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock settings_address_widget %}

{# Image Upload Widget - logo upload with preview only if logo exists #}
{% block image_upload_widget %}
    {% set currentLogo = app_logo(width=80, showDefault=false) %}
    <div class="logo-upload-card d-flex align-items-start gap-4 p-3 bg-light rounded-3 border">
        {% if currentLogo is not empty %}
            <div class="flex-shrink-0">
                <div class="logo-preview-frame">
                    {{ currentLogo|raw }}
                </div>
            </div>
        {% endif %}
        <div class="flex-grow-1">
            {{ block('dropzone_widget') }}
            <p class="text-muted small mt-2 mb-0">
                {{ 'settings.logo.help'|trans }}
            </p>
        </div>
    </div>
{% endblock image_upload_widget %}

{# Invoice/Quote design template picker - card gallery with live previews.
   Self-contained styling (see settings.scss) — no Tabler form-imagecheck dependency. #}
{% block invoice_template_widget %}
    <div id="{{ id }}" class="row g-3 template-picker{% if disabled %} template-picker-disabled{% endif %}">
        {% for child in form %}
            {% set previewUrl = path('saas_template_preview', {slug: child.vars.value}) %}
            <div class="col-sm-6 col-xl-4">
                <div class="template-picker-card card h-100">
                    <label class="template-picker-option" for="{{ child.vars.id }}">
                        {{ form_widget(child, {attr: {class: 'template-picker-input'}}) }}
                        <span class="template-picker-thumb">
                            <iframe src="{{ previewUrl }}" loading="lazy" tabindex="-1" scrolling="no" title="{{ child.vars.label }}" aria-hidden="true"></iframe>
                        </span>
                        <span class="template-picker-check" aria-hidden="true">
                            {{ ux_icon('tabler:check', {width: 16, height: 16}) }}
                        </span>
                    </label>
                    <div class="card-footer d-flex align-items-center justify-content-between py-2 px-3">
                        <span class="fw-medium">{{ child.vars.label }}</span>
                        <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="btn btn-sm btn-ghost" title="{{ 'settings.page.design.template.preview_full'|trans }}">
                            {{ ux_icon('tabler:eye', {width: 16, height: 16}) }}
                            {{ 'settings.page.design.template.preview'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock invoice_template_widget %}

{# Mail Transport Type - provider selector with config panels #}
{% block mail_transport_widget %}
    <div {{ stimulus_controller('mailsettings') }}>
        {% for child in form %}
            {% if child.vars.name == 'provider' %}
                <div class="mb-3">
                    {{ form_row(child) }}
                </div>
            {% else %}
                <div class="mail-provider-config {{ child.vars.row_attr.class|default('') }}"
                     data-provider="{{ child.vars.name }}">
                    <div class="card bg-light border-0 mt-3">
                        <div class="card-body">
                            {{ form_widget(child) }}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endblock mail_transport_widget %}
