{% extends '@SolidInvoiceCore/Layout/default.html.twig' %}

{% block title %}{{ ux_icon('tabler:forms', {width: 24, height: 24, class: 'me-2'}) }}{{ (mode == 'create' ? 'New custom field' : 'Edit custom field')|trans }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h2 class="page-title">{{ (mode == 'create' ? 'New custom field' : 'Edit custom field')|trans }}</h2>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.label) }}</div>
                    <div class="col-md-6">
                        {% if mode == 'edit' and usageCount > 0 %}
                            <div class="alert alert-info">
                                {{ 'This field has %count% values; type cannot be changed. Delete and recreate to change type.'|trans({'%count%': usageCount}) }}
                            </div>
                            {{ form_row(form.type, {attr: {disabled: 'disabled'}}) }}
                        {% else %}
                            {{ form_row(form.type) }}
                        {% endif %}
                    </div>
                    <div class="col-md-6">{{ form_row(form.required) }}</div>
                </div>

                {% set selectTypes = ['select', 'multi_select'] %}
                {% set isSelectType = form.type.vars.value in selectTypes %}
                <div class="mt-4"
                     {% if not isSelectType %}hidden{% endif %}
                     {{ stimulus_controller('custom-field-options', {
                         prototype: form_widget(form.options.vars.prototype),
                         index: form.options|length,
                         selectTypes: selectTypes,
                         typeTargetId: form.type.vars.id,
                     }) }}>
                    <div class="d-flex align-items-center mb-2">
                        <h4 class="mb-0 me-2">{{ 'Options'|trans }}</h4>
                        <span class="text-muted small">{{ '(used for single- and multi-select)'|trans }}</span>
                    </div>

                    <div {{ stimulus_target('custom-field-options', 'list') }}>
                        {% for option in form.options %}
                            <div class="d-flex align-items-center mb-2" {{ stimulus_target('custom-field-options', 'row') }}>
                                <div class="flex-fill">{{ form_widget(option) }}</div>
                                <button type="button" class="btn btn-link text-danger ms-2" {{ stimulus_action('custom-field-options', 'remove') }} title="{{ 'Remove'|trans }}">
                                    {{ ux_icon('tabler:trash', {width: 18, height: 18}) }}
                                </button>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" {{ stimulus_action('custom-field-options', 'add') }}>
                        {{ ux_icon('tabler:plus', {width: 14, height: 14}) }}
                        {{ 'Add option'|trans }}
                    </button>
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary" type="submit">{{ 'Save'|trans }}</button>
                    <a class="btn btn-link" href="{{ path('_settings_custom_fields') }}">{{ 'Cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
