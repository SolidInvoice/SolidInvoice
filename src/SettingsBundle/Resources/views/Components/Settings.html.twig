{% form_theme form '@SolidInvoiceSettings/Form/fields.html.twig' %}

{# Tab metadata for navigation #}
{% set tabMeta = {
    'system': {'title': 'settings.page.tab.system'|trans, 'icon': 'tabler:building'},
    'invoice': {'title': 'settings.page.tab.invoice'|trans, 'icon': 'tabler:file-invoice'},
    'quote': {'title': 'settings.page.tab.quote'|trans, 'icon': 'tabler:file-text'},
    'email': {'title': 'settings.page.tab.email'|trans, 'icon': 'tabler:mail'},
    'design': {'title': 'settings.page.tab.design'|trans, 'icon': 'tabler:palette'}
} %}

<div class="settings-page"{{ attributes }}>
    {# Tabs Navigation #}
    <ul class="nav nav-underline mb-4" role="tablist">
        {% for settingsSection, setting in appSettings %}
            {% set meta = tabMeta[settingsSection]|default({
                'title': settingsSection|replace({'_': ' '})|title|trans,
                'icon': 'tabler:settings'
            }) %}
            <li class="nav-item">
                <a href="{{ path('_settings', {section: settingsSection}) }}"
                   class="nav-link{{ settingsSection is same as section ? ' active' : '' }}"
                   {% if settingsSection is same as section %}aria-current="page"{% endif %}>
                    <span class="nav-link-icon d-none d-sm-inline-block">
                        {{ ux_icon(meta.icon, {width: 16, height: 16}) }}
                    </span>
                    <span>{{ meta.title }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>

    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'prevent|files|save'
        }
    }) }}

    {# Settings Content Card #}
    <div class="card settings-content-card">
        <div class="card-body">
            {# Render form fields with better organization #}
            {% if section == 'system' %}
                {# Company Settings - Custom Layout #}
                {% if form.company is defined %}
                    {# Company Profile Section - Name first, then Logo #}
                    <div class="mb-4 pb-4 border-bottom">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:building', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.company.profile'|trans }}
                        </h3>
                        <div class="row g-4">
                            {% if form.company.company_name is defined %}
                                <div class="col-12">
                                    {{ form_row(form.company.company_name, {
                                        label: 'settings.page.company.name'|trans,
                                        attr: {placeholder: 'settings.page.company.name_placeholder'|trans}
                                    }) }}
                                </div>
                            {% endif %}
                            {% if form.company.logo is defined %}
                                <div class="col-12">
                                    <label class="form-label">{{ 'settings.page.company.logo'|trans }}</label>
                                    {{ form_row(form.company.logo) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Business Details Section #}
                    <div class="mb-4 pb-4 border-bottom">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:file-text', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.company.business_details'|trans }}
                        </h3>
                        <div class="row g-3">
                            {% if form.company.currency is defined %}
                                <div class="col-md-6">
                                    {{ form_row(form.company.currency, {
                                        label: 'settings.page.company.currency'|trans,
                                        help: 'settings.page.company.currency_help'|trans
                                    }) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Contact Details Section #}
                    {% if form.company.contact_details is defined %}
                        <div class="mb-4 pb-4 border-bottom">
                            <h3 class="d-flex align-items-center gap-2 mb-3">
                                {{ ux_icon('tabler:map-pin', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                                {{ 'settings.page.company.contact_details'|trans }}
                            </h3>
                            <p class="text-muted small mb-3">
                                {{ 'settings.page.company.contact_help'|trans }}
                            </p>
                            <div class="row g-3">
                                {% if form.company.contact_details.email is defined %}
                                    <div class="col-md-6">
                                        {{ form_row(form.company.contact_details.email, {
                                            label: 'settings.page.company.contact_email'|trans,
                                            attr: {placeholder: 'settings.page.company.contact_email_placeholder'|trans}
                                        }) }}
                                    </div>
                                {% endif %}
                                {% if form.company.contact_details.phone_number is defined %}
                                    <div class="col-md-6">
                                        {{ form_row(form.company.contact_details.phone_number, {
                                            label: 'settings.page.company.phone'|trans,
                                            attr: {placeholder: 'settings.page.company.phone_placeholder'|trans}
                                        }) }}
                                    </div>
                                {% endif %}
                            </div>
                            {% if form.company.contact_details.address is defined %}
                                <div class="mt-3">
                                    <label class="form-label fw-medium mb-2">{{ 'settings.page.company.business_address'|trans }}</label>
                                    {{ form_widget(form.company.contact_details.address) }}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                {% endif %}

                {# Domain Section #}
                {% if form.domain is defined and form.domain.custom_domain is defined %}
                    <div class="mb-4 pb-4 border-bottom">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:world', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.domain.title'|trans }}
                        </h3>
                        <p class="text-muted small mb-3">
                            {{ 'settings.page.domain.subtitle'|trans }}
                        </p>
                        {{ form_row(form.domain.custom_domain, {
                            label: 'settings.page.domain.custom_domain'|trans,
                            attr: {placeholder: 'invoices.yourcompany.com'}
                        }) }}

                        {% if custom_domain_dns_record is not empty %}
                            <div class="alert alert-info mt-3" role="alert">
                                <div class="d-flex">
                                    <div class="me-3">
                                        {{ ux_icon('tabler:info-circle', {width: 24, height: 24, 'aria-hidden': 'true'}) }}
                                    </div>
                                    <div class="flex-grow-1">
                                        <h4 class="alert-title mb-1">{{ 'settings.page.domain.dns_title'|trans }}</h4>
                                        <p class="mb-2">
                                            {{ 'settings.page.domain.dns_help'|trans }}
                                        </p>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-2 align-middle">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">{{ 'settings.page.domain.dns_type'|trans }}</th>
                                                        <th scope="col">{{ 'settings.page.domain.dns_name'|trans }}</th>
                                                        <th scope="col">{{ 'settings.page.domain.dns_value'|trans }}</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><code>CNAME</code></td>
                                                        <td><code>{{ form.domain.custom_domain.vars.value|default('invoices.yourcompany.com') }}</code></td>
                                                        <td><code>{{ custom_domain_dns_record }}</code></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <p class="text-muted small mb-0">
                                            {{ 'settings.page.domain.dns_footer'|trans }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {# General Settings Section #}
                {% if form.general is defined %}
                    <div>
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:settings', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.general.title'|trans }}
                        </h3>
                        {{ form_widget(form.general) }}
                    </div>
                {% endif %}

            {% elseif section == 'invoice' or section == 'quote' %}
                {# Invoice/Quote Settings - Custom Layout #}

                {# Display Settings #}
                <div class="mb-4 pb-4 border-bottom">
                    <h3 class="d-flex align-items-center gap-2 mb-3">
                        {{ ux_icon('tabler:eye', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.display.title'|trans }}
                    </h3>
                    {% if form.watermark is defined %}
                        {{ form_row(form.watermark, {
                            label: 'settings.page.display.watermark'|trans,
                            help: 'settings.watermark.help'|trans({'%type%': ('label.' ~ section)|trans})
                        }) }}
                    {% endif %}
                </div>

                {# Email Settings #}
                <div class="mb-4 pb-4 border-bottom">
                    <h3 class="d-flex align-items-center gap-2 mb-3">
                        {{ ux_icon('tabler:mail', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.email.notifications'|trans }}
                    </h3>
                    <div class="row g-3">
                        {% if form.email_subject is defined %}
                            <div class="col-12">
                                {{ form_row(form.email_subject, {
                                    label: 'settings.page.email.subject'|trans,
                                    help: 'settings.email_subject.help'|trans({'%type%': ('label.' ~ section)|trans}),
                                    attr: {placeholder: 'settings.email_subject.placeholder'|trans({'%type%': ('label.' ~ section)|trans|title})}
                                }) }}
                            </div>
                        {% endif %}
                        {% if form.bcc_address is defined %}
                            <div class="col-12">
                                {{ form_row(form.bcc_address, {
                                    label: 'settings.page.email.bcc'|trans,
                                    help: 'settings.bcc_address.help'|trans({'%type%': ('label.' ~ section)|trans}),
                                    attr: {placeholder: 'bcc@yourcompany.com'}
                                }) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ID Generation Settings #}
                {% if form.id_generation is defined %}
                    <div>
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:hash', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.numbering.title'|trans }}
                        </h3>
                        <p class="text-muted small mb-3">
                            {{ 'settings.numbering.description'|trans({'%type%': ('label.' ~ section)|trans}) }}
                        </p>
                        <div class="row g-3">
                            {% if form.id_generation.strategy is defined %}
                                <div class="col-12">
                                    {{ form_row(form.id_generation.strategy, {
                                        label: 'settings.page.numbering.strategy'|trans,
                                        help: 'settings.numbering_strategy.help'|trans({'%type%': ('label.' ~ section)|trans})
                                    }) }}
                                </div>
                            {% endif %}
                            {% if form.id_generation.id_prefix is defined %}
                                <div class="col-md-6">
                                    {{ form_row(form.id_generation.id_prefix, {
                                        label: 'settings.page.numbering.prefix'|trans,
                                        help: 'settings.page.numbering.prefix_help'|trans,
                                        attr: {placeholder: section == 'invoice' ? 'INV-' : 'QUO-'}
                                    }) }}
                                </div>
                            {% endif %}
                            {% if form.id_generation.id_suffix is defined %}
                                <div class="col-md-6">
                                    {{ form_row(form.id_generation.id_suffix, {
                                        label: 'settings.page.numbering.suffix'|trans,
                                        help: 'settings.page.numbering.suffix_help'|trans,
                                        attr: {placeholder: '-2024'}
                                    }) }}
                                </div>
                            {% endif %}
                        </div>

                        {# Preview of numbering #}
                        <div class="mt-3 p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">{{ 'settings.page.numbering.example'|trans }}</span>
                                <code class="fs-6">
                                    {% set prefix = form.id_generation.id_prefix.vars.value|default('') %}
                                    {% set suffix = form.id_generation.id_suffix.vars.value|default('') %}
                                    {{ prefix }}001{{ suffix }}
                                </code>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Payment Reminders Section #}
                {% if section == 'invoice' and form.reminder is defined %}
                    <div class="mt-4">
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:bell', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.reminder.title'|trans }}
                        </h3>
                        <p class="text-muted small mb-3">
                            {{ 'settings.page.reminder.subtitle'|trans }}
                        </p>

                        {# Enable Reminders Toggle #}
                        {% if form.reminder.enabled is defined %}
                            <div class="mb-4">
                                {{ form_row(form.reminder.enabled, {
                                    label: 'settings.page.reminder.enable'|trans,
                                    help: 'settings.page.reminder.enable_help'|trans
                                }) }}
                            </div>
                        {% endif %}

                        {# Reminder Configuration Card #}
                        <div class="card bg-light border-0">
                            <div class="card-body">
                                <div class="row g-4">
                                    {# Pre-Due Reminder Settings #}
                                    <div class="col-12">
                                        <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                                            <div class="text-primary mt-1">
                                                {{ ux_icon('tabler:calendar-event', {width: 20, height: 20, 'aria-hidden': 'true'}) }}
                                            </div>
                                            <div class="flex-grow-1">
                                                <h5 class="mb-2">{{ 'settings.page.reminder.pre_due.title'|trans }}</h5>
                                                <p class="text-muted small mb-3">
                                                    {{ 'settings.page.reminder.pre_due.subtitle'|trans }}
                                                </p>

                                                {% if form.reminder.pre_due_enabled is defined %}
                                                    {{ form_row(form.reminder.pre_due_enabled, {
                                                        label: 'settings.page.reminder.pre_due.enable'|trans
                                                    }) }}
                                                {% endif %}

                                                {% if form.reminder.pre_due_days is defined %}
                                                    <div class="mt-3">
                                                        {{ form_row(form.reminder.pre_due_days, {
                                                            label: 'settings.page.reminder.pre_due.days'|trans,
                                                            help: 'settings.page.reminder.pre_due.days_help'|trans,
                                                            attr: {min: 0, max: 30, placeholder: '3'}
                                                        }) }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>

                                    {# Overdue Reminder Schedule #}
                                    <div class="col-12">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="text-warning mt-1">
                                                {{ ux_icon('tabler:clock-exclamation', {width: 20, height: 20, 'aria-hidden': 'true'}) }}
                                            </div>
                                            <div class="flex-grow-1">
                                                <h5 class="mb-2">{{ 'settings.page.reminder.overdue.title'|trans }}</h5>
                                                <p class="text-muted small mb-3">
                                                    {{ 'settings.page.reminder.overdue.subtitle'|trans }}
                                                </p>

                                                <div class="alert alert-info d-flex align-items-start gap-2 mb-0" role="status">
                                                    {{ ux_icon('tabler:info-circle', {width: 20, height: 20, class: 'flex-shrink-0 mt-1', 'aria-hidden': 'true'}) }}
                                                    <div class="small">
                                                        <strong>{{ 'settings.page.reminder.overdue.tone_label'|trans }}</strong>
                                                        {{ 'settings.page.reminder.overdue.tone_help'|trans }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Information Alert #}
                        <div class="alert alert-primary d-flex align-items-start gap-2 mt-3" role="status">
                            {{ ux_icon('tabler:info-circle', {width: 20, height: 20, class: 'flex-shrink-0 mt-1', 'aria-hidden': 'true'}) }}
                            <div class="small">
                                <strong>{{ 'settings.page.reminder.how_label'|trans }}</strong>
                                {{ 'settings.page.reminder.how_help'|trans }}
                            </div>
                        </div>
                    </div>
                {% endif %}

            {% elseif section == 'email' %}
                {# Email Settings - Custom Layout #}

                {# Sender Information #}
                <div class="mb-4 pb-4 border-bottom">
                    <h3 class="d-flex align-items-center gap-2 mb-3">
                        {{ ux_icon('tabler:user', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.email.sender.title'|trans }}
                    </h3>
                    <p class="text-muted small mb-3">
                        {{ 'settings.page.email.sender.subtitle'|trans }}
                    </p>
                    <div class="row g-3">
                        {% if form.from_name is defined %}
                            <div class="col-md-6">
                                {{ form_row(form.from_name, {
                                    label: 'settings.page.email.sender.from_name'|trans,
                                    help: 'settings.page.email.sender.from_name_help'|trans,
                                    attr: {placeholder: 'settings.page.email.sender.from_name_placeholder'|trans}
                                }) }}
                            </div>
                        {% endif %}
                        {% if form.from_address is defined %}
                            <div class="col-md-6">
                                {{ form_row(form.from_address, {
                                    label: 'settings.page.email.sender.from_address'|trans,
                                    help: 'settings.page.email.sender.from_address_help'|trans,
                                    attr: {placeholder: 'no-reply@yourcompany.com'}
                                }) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Mail Provider Settings #}
                {% if form.sending_options is defined %}
                    <div>
                        <h3 class="d-flex align-items-center gap-2 mb-3">
                            {{ ux_icon('tabler:server', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.email.delivery.title'|trans }}
                        </h3>
                        <p class="text-muted small mb-3">
                            {{ 'settings.page.email.delivery.subtitle'|trans }}
                        </p>
                        {{ form_widget(form.sending_options) }}
                    </div>
                {% endif %}

            {% elseif section == 'design' and form.template is defined %}
                {# Design Settings - Invoice/Quote template picker (SaaS only) #}
                <div>
                    <h3 class="d-flex align-items-center gap-2 mb-3">
                        {{ ux_icon('tabler:palette', {width: 22, height: 22, class: 'text-primary', 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.design.template.title'|trans }}
                    </h3>
                    <p class="text-muted small mb-3">
                        {{ 'settings.page.design.template.subtitle'|trans }}
                    </p>

                    {% if form.template.vars.feature_gated_active|default(false) %}
                        {{ upgrade_prompt(constant('SolidInvoice\\SaasBundle\\Feature\\Feature::CustomTemplates').value) }}
                    {% endif %}

                    {{ form_widget(form.template) }}
                </div>
            {% else %}
                {# Default Rendering for Other Sections #}
                {{ form_widget(form) }}
            {% endif %}
        </div>

        {# Save Button Footer #}
        <div class="card-footer bg-transparent border-top">
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary btn-save" aria-label="{{ 'settings.page.save'|trans }}">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18, 'aria-hidden': 'true'}) }}
                    {{ 'settings.page.save'|trans }}
                </button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

    {# Company Tax Identifiers - Only for System Section #}
    {% if section is same as('system') %}
        <div class="card settings-content-card mt-4">
            <div class="card-body">
                <twig:CompanyTaxIdentifiers />
            </div>
        </div>
    {% endif %}

    {# Danger Zone - Only for System Section #}
    {% if section is same as('system') %}
        <div class="settings-danger-zone mt-4" role="region" aria-labelledby="danger-zone-heading"
             {{ stimulus_controller('delete-company', {'company-name': company_name()}) }}>
            <div class="card border-danger">
                <div class="card-header bg-danger bg-opacity-10 border-danger">
                    <h5 class="card-title text-danger mb-0 d-flex align-items-center gap-2" id="danger-zone-heading">
                        {{ ux_icon('tabler:alert-triangle', {width: 20, height: 20, 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.danger.title'|trans }}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
                        <div>
                            <h3 class="mb-1">{{ 'settings.page.danger.delete'|trans }}</h3>
                            <p class="text-muted mb-0">
                                {{ 'settings.page.danger.delete_help'|trans }}
                            </p>
                        </div>
                        <button type="button"
                                class="btn btn-outline-danger flex-shrink-0 gap-2"
                                aria-label="{{ 'settings.page.danger.delete'|trans }}"
                                {{ stimulus_action('delete-company', 'showModal', 'click') }}>
                            {{ ux_icon('tabler:trash', {width: 16, height: 16, 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.danger.delete'|trans }}
                        </button>
                    </div>
                </div>
            </div>

            {# Delete Company Modal #}
            <div class="modal fade"
                 id="deleteCompanyModal"
                 tabindex="-1"
                 aria-labelledby="deleteCompanyModalLabel"
                 aria-hidden="true"
                 {{ stimulus_target('delete-company', 'modal') }}>
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title text-danger d-flex align-items-center gap-2" id="deleteCompanyModalLabel">
                                {{ ux_icon('tabler:alert-triangle', {width: 20, height: 20, 'aria-hidden': 'true'}) }}
                                {{ 'settings.page.danger.modal.title'|trans }}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'action.close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                                {{ ux_icon('tabler:alert-circle', {width: 20, height: 20, class: 'flex-shrink-0 mt-1', 'aria-hidden': 'true'}) }}
                                <div>
                                    <strong>{{ 'settings.page.danger.modal.warning'|trans }}</strong>
                                    {{ 'settings.page.danger.modal.warning_help'|trans }}
                                </div>
                            </div>
                            <p class="mb-2">
                                {{ 'settings.page.danger.modal.confirm_prompt'|trans }}
                            </p>
                            <p class="fw-bold text-danger fs-5 mb-3 font-monospace" aria-label="{{ 'settings.page.danger.modal.company_name_aria'|trans }}">{{ company_name() }}</p>
                            <div class="mb-3">
                                <label for="companyNameConfirmation" class="form-label">
                                    {{ 'settings.page.company.name'|trans }}
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="companyNameConfirmation"
                                       name="company_name"
                                       form="deleteCompanyForm"
                                       autocomplete="off"
                                       aria-required="true"
                                       {{ stimulus_target('delete-company', 'companyNameInput') }}
                                       {{ stimulus_action('delete-company', 'validateInput', 'input') }}
                                       placeholder="{{ 'settings.page.danger.modal.input_placeholder'|trans }}">
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">
                                {{ 'action.cancel'|trans }}
                            </button>
                            <form id="deleteCompanyForm" action="{{ path('_delete_company') }}" method="post" class="d-inline">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_company') }}">
                                <button type="submit"
                                        class="btn btn-danger gap-2"
                                        aria-label="{{ 'settings.page.danger.delete'|trans }}"
                                        {{ stimulus_target('delete-company', 'confirmButton') }}
                                        disabled>
                                    {{ ux_icon('tabler:trash', {width: 16, height: 16, 'aria-hidden': 'true'}) }}
                                    {{ 'settings.page.danger.delete'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
