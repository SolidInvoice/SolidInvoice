{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:receipt-refund', {width: 24, height: 24, class: 'me-2'}) }}{{ "credit_note.list.title"|trans }}
{% endblock title %}

{% block heading %}
    <a class="btn btn-primary" href="{{ path("_credit_notes_create") }}">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ "credit_note.menu.create"|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <twig:DataGrid name="credit_note_grid" />
    </twig:Ui:Card>
{% endblock content %}
