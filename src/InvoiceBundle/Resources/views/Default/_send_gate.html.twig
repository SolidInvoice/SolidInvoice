{#
 # Why Send is disabled for an unverified user, and how to fix it. The resend button submits
 # resend_form() by id, because the invoice editor's actions sit inside its own <form> and forms
 # cannot nest — render resend_form() once on the page, outside any other form.
 #}
{% macro hint(message = 'invoice.send.verify_hint') %}
    <span class="small text-secondary" id="send-gated-hint">
        {{ ux_icon('tabler:mail-exclamation', {width: 16, height: 16}) }}
        {{ message|trans }}
        <button type="submit" form="resend-verification-email" class="btn btn-link btn-sm p-0 align-baseline">{{ 'invoice.send.resend_link'|trans }}</button>
    </span>
{% endmacro %}

{% macro resend_form() %}
    <form method="post" action="{{ path('_solidworx_platform_verify_email_resend') }}" id="resend-verification-email" class="d-none">
        <input type="hidden" name="_token" value="{{ csrf_token('resend_verification_email') }}">
    </form>
{% endmacro %}

{# Sends the saved invoice to the user's own inbox, and the email confirms their address. #}
{% macro test_copy(invoice) %}
    <form method="post" action="{{ path('_invoices_send_test_copy', {'id': invoice.id}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('send_test_copy') }}">
        <button type="submit" class="btn btn-outline-primary">
            {{ ux_icon('tabler:mail-forward', {width: 18, height: 18}) }}
            {{ 'invoice.test_copy.button'|trans }}
        </button>
    </form>
{% endmacro %}
