{% extends "@SolidInvoiceCore/Layout/Email/notification.html.twig" %}
{% import "@SolidInvoiceCore/Layout/Email/components.html.twig" as email %}

{%- block title -%}
    {{ 'invoice.recurring_created.heading'|trans({}, 'email') }}
{%- endblock -%}

{%- block content -%}
    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                    {{ 'invoice.recurring_created.message'|trans({}, 'email') }}
                </p>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# Invoice details #}
    {{ email.info_row('invoice.number'|trans({}, 'email'), invoice.invoiceId, true) }}

    {% if invoice.client %}
        {{ email.spacer('xs') }}
        {{ email.info_row('label.client'|trans, invoice.client.name) }}
    {% endif %}

    {{ email.spacer('xs') }}
    {{ email.info_row('invoice.created'|trans({}, 'email'), invoice.invoiceDate|date('Y-m-d')) }}

    {% if invoice.due %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.due'|trans({}, 'email'), invoice.due|date('Y-m-d')) }}
    {% endif %}

    {{ email.spacer('xs') }}
    {{ email.info_row('label.status'|trans, invoice.status.label) }}

    {# Line items #}
    {% if invoice.lines|length > 0 %}
        {{ email.divider('md') }}

        {% for line in invoice.lines %}
            {{ email.info_row(line.name ~ ' × ' ~ line.qty, line.total|formatCurrency(invoice.currency)) }}
            {% if not loop.last %}
                {{ email.spacer('xs') }}
            {% endif %}
        {% endfor %}
    {% endif %}

    {{ email.divider('md') }}

    {# Totals #}
    {{ email.info_row('invoice.subtotal'|trans({}, 'email'), invoice.baseTotal|formatCurrency(invoice.currency)) }}

    {% if invoice.tax.positive %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.tax'|trans({}, 'email'), invoice.tax|formatCurrency(invoice.currency)) }}
    {% endif %}

    {% if invoice.discount.type is not empty %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.discount'|trans({}, 'email'), '-' ~ discount(invoice)|formatCurrency(invoice.currency)) }}
    {% endif %}

    {{ email.spacer('sm') }}
    {{ email.info_row('invoice.total'|trans({}, 'email'), invoice.total|formatCurrency(invoice.currency), true) }}

    {{ email.divider('md') }}

    {# View button #}
    {{ email.button('invoice.recurring_created.view_invoice'|trans({}, 'email'), url('_invoices_view', {'id': invoice.id}), 'primary', 'large') }}

    {{ email.spacer('md') }}
{%- endblock -%}
