{% extends "@SolidInvoiceCore/Layout/Email/notification.html.twig" %}
{% import "@SolidInvoiceCore/Layout/Email/components.html.twig" as email %}

{%- block title -%}
    {%- if reminder_type == 'pre_due' -%}
        {{ 'invoice.reminder.title.pre_due'|trans({}, 'email') }}
    {%- elseif reminder_type == 'overdue_1' -%}
        {{ 'invoice.reminder.title.overdue_1'|trans({}, 'email') }}
    {%- elseif reminder_type == 'overdue_7' -%}
        {{ 'invoice.reminder.title.overdue_7'|trans({}, 'email') }}
    {%- elseif reminder_type == 'overdue_14' -%}
        {{ 'invoice.reminder.title.overdue_14'|trans({}, 'email') }}
    {%- else -%}
        {{ 'invoice.reminder.title.default'|trans({}, 'email') }}
    {%- endif -%}
{%- endblock -%}

{%- block content -%}
    {% apply inky_to_html %}
        <row>
            <columns>
                {%- if reminder_type == 'pre_due' -%}
                    <p style="color: #0891b2; font-size: 18px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                        💡 {{ 'invoice.reminder.heading.pre_due'|trans({}, 'email') }}
                    </p>
                    <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                        {{ 'invoice.reminder_email.pre_due'|trans({'invoice': '<strong>' ~ invoice.invoiceId|e ~ '</strong>', 'days': days_until_due ?? 0}, 'messages')|raw }}
                    </p>
                {%- elseif reminder_type == 'overdue_1' -%}
                    <p style="color: #f59e0b; font-size: 18px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                        📋 {{ 'invoice.reminder.heading.overdue_1'|trans({}, 'email') }}
                    </p>
                    <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                        {{ 'invoice.reminder.message.overdue_1'|trans({'%invoice%': '<strong>' ~ invoice.invoiceId|e ~ '</strong>'}, 'email')|raw }}
                    </p>
                {%- elseif reminder_type == 'overdue_7' -%}
                    <p style="color: #ea580c; font-size: 18px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                        ⏰ {{ 'invoice.reminder.heading.overdue_7'|trans({}, 'email') }}
                    </p>
                    <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                        {{ 'invoice.reminder_email.overdue_7'|trans({'invoice': '<strong>' ~ invoice.invoiceId|e ~ '</strong>', 'days': 7}, 'messages')|raw }}
                    </p>
                {%- elseif reminder_type == 'overdue_14' -%}
                    <p style="color: #dc2626; font-size: 18px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                        🚨 {{ 'invoice.reminder.heading.overdue_14'|trans({}, 'email') }}
                    </p>
                    <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                        {{ 'invoice.reminder_email.overdue_14'|trans({'invoice': '<strong>' ~ invoice.invoiceId|e ~ '</strong>', 'days': 14}, 'messages')|raw }}
                    </p>
                {%- else -%}
                    <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                        {{ 'invoice.reminder.message.default'|trans({'%invoice%': '<strong>' ~ invoice.invoiceId|e ~ '</strong>'}, 'email')|raw }}
                    </p>
                {%- endif -%}
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# Invoice details #}
    {{ email.info_row('invoice.overdue.invoice_number'|trans({}, 'email'), invoice.invoiceId) }}

    {% if invoice.invoiceDate %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.reminder.invoice_date'|trans({}, 'email'), invoice.invoiceDate|date('Y-m-d')) }}
    {% endif %}

    {% if invoice.due %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.due'|trans({}, 'email'), invoice.due|date('Y-m-d')) }}
    {% endif %}

    {% if invoice.balance %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.reminder.amount_due'|trans({}, 'email'), invoice.balance|formatCurrency(invoice.currency), true) }}
    {% endif %}

    {{ email.divider('md') }}

    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #475569; font-size: 14px; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    {%- if reminder_type == 'pre_due' -%}
                        {{ 'invoice.reminder.closing.pre_due'|trans({}, 'email') }}
                    {%- else -%}
                        {{ 'invoice.reminder.closing.overdue'|trans({}, 'email') }}
                    {%- endif -%}
                </p>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# View/Pay button #}
    {{ email.button('invoice.reminder.view_and_pay'|trans({}, 'email'), url("_view_invoice_external", {"uuid" : invoice.uuid}), 'primary', 'large') }}

    {{ email.spacer('md') }}

    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #64748b; font-size: 13px; line-height: 1.5; margin: 0; Margin: 0;">
                    {{ 'invoice.reminder.contact'|trans({}, 'email') }}
                </p>
            </columns>
        </row>
    {% endapply %}
{%- endblock -%}
