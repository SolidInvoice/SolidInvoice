{% extends "@SolidInvoiceCore/Layout/Email/notification.html.twig" %}
{% import "@SolidInvoiceCore/Layout/Email/components.html.twig" as email %}

{%- block title -%}
    {{ 'invoice.reminder_stopped.title'|trans({}, 'email') }}
{%- endblock -%}

{%- block content -%}
    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #dc2626; font-size: 18px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    🔔 {{ 'invoice.reminder_stopped.heading'|trans({}, 'email') }}
                </p>
                <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                    {%- if days_overdue is defined and days_overdue is not null -%}
                        {{ 'invoice.reminder_email.stopped_days_overdue'|trans({'invoice': '<strong>' ~ invoice.invoiceId|e ~ '</strong>', 'days': days_overdue}, 'messages')|raw }}
                    {%- else -%}
                        {{ 'invoice.reminder_stopped.message'|trans({'%invoice%': '<strong>' ~ invoice.invoiceId|e ~ '</strong>'}, 'email')|raw }}
                    {%- endif -%}
                </p>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# Invoice details #}
    {{ email.info_row('invoice.overdue.invoice_number'|trans({}, 'email'), invoice.invoiceId) }}

    {% if invoice.client %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.notification_overdue.client'|trans({}, 'email'), invoice.client.name) }}
    {% endif %}

    {% if invoice.due %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.due'|trans({}, 'email'), invoice.due|date('Y-m-d')) }}
    {% endif %}

    {% if days_overdue %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.reminder_stopped.days_overdue'|trans({}, 'email'), days_overdue, true) }}
    {% endif %}

    {% if invoice.balance %}
        {{ email.spacer('xs') }}
        {{ email.info_row('invoice.reminder_stopped.outstanding_amount'|trans({}, 'email'), invoice.balance|formatCurrency(invoice.currency), true) }}
    {% endif %}

    {{ email.divider('md') }}

    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #475569; font-size: 14px; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    <strong>{{ 'invoice.reminder_stopped.actions.heading'|trans({}, 'email') }}:</strong>
                </p>
                <ul style="color: #475569; font-size: 14px; line-height: 1.6; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    <li>{{ 'invoice.reminder_stopped.actions.contact'|trans({}, 'email') }}</li>
                    <li>{{ 'invoice.reminder_stopped.actions.history'|trans({}, 'email') }}</li>
                    <li>{{ 'invoice.reminder_stopped.actions.payment_plan'|trans({}, 'email') }}</li>
                    <li>{{ 'invoice.reminder_stopped.actions.services'|trans({}, 'email') }}</li>
                </ul>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# View invoice button #}
    {{ email.button('invoice.notification_overdue.view_invoice'|trans({}, 'email'), url("_view_invoice", {"id" : invoice.id}), 'primary', 'large') }}

    {{ email.spacer('md') }}

    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #64748b; font-size: 13px; line-height: 1.5; margin: 0; Margin: 0;">
                    {{ 'invoice.reminder_stopped.footer'|trans({}, 'email') }}
                </p>
            </columns>
        </row>
    {% endapply %}
{%- endblock -%}
