<div class="col-6">
    <div class="card mt-2">
        <div class="card-header">
            <h3 class="card-title">
                {{ icon('group') }} {{ 'dashboard.client.recent'|trans }}
            </h3>
        </div>
        {% if clients is not empty %}
            <div class="list-group list-group-flush dashboard-widget">
                {% for client in clients %}
                    <div class="list-group-item list-group-item-action">

                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-secondary btn-icon w-100 btn-sm px-1 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                        {{ icon('cog') }}
                                    </button>
                                    <div class="dropdown-menu" role="menu">
                                        <a href="{{ path('_clients_view', {'id' : client.id}) }}" class="dropdown-item">
                                            {{ icon('eye') }}&nbsp;{{ 'dashboard.client.actions.view'|trans }}
                                        </a>
                                        <a href="{{ path('_clients_edit', {'id' : client.id}) }}" class="dropdown-item">
                                            {{ icon('edit') }}&nbsp;{{ 'dashboard.client.actions.edit'|trans }}
                                        </a>
                                        <a href="{{ path('_quotes_create', {'client' : client.id}) }}" class="dropdown-item">
                                            {{ icon('file-text-o') }}&nbsp;{{ 'dashboard.client.actions.create.quote'|trans }}
                                        </a>
                                        <a href="{{ path('_invoices_create', {'client' : client.id}) }}" class="dropdown-item">
                                            {{ icon('file-text-o') }}&nbsp;{{ 'dashboard.client.actions.create.invoice'|trans }}
                                        </a>

                                    </div>
                                </div>
                            </div>

                            <div class="col-auto">
                                {{ client_label(client.status) }}
                            </div>

                            <div class="col-auto">
                                <a href="{{ path('_clients_view', {'id' : client.id}) }}">
                                    {{ client.name }}
                                </a>
                            </div>

                            <div class="col text-end">
                                <strong>
                                    {{ 'dashboard.client.actions.created'|trans }}
                                </strong> {{ client.created|diff }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="card-footer text-center border-top-0">
                <a href="{{ path('_clients_index') }}" class="uppercase">
                    {{ 'dashboard.client.view_all'|trans }}
                </a>
            </div>
        {% else %}
            <div class="card-body">
                <div class="text-center">
                    <h6>
                        {{ 'dashboard.client.empty'|trans }}
                    </h6>
                    <a href="{{ path('_clients_add') }}">
                        {{ icon('plus') }} {{ 'dashboard.client.create'|trans }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
