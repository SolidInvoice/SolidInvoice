<div class="col-sm-9">
    <div class="row row-cards">
        <div class="col-sm-6">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-primary text-white avatar">
                              {{ icon('group') }}
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium">
                                {{ totalClients }} {{ 'dashboard.active_clients'|trans }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-green text-white avatar">
                              {{ icon('money') }}
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium">
                                {{ 'dashboard.income_received'|trans }}
                            </div>
                            <div class="text-secondary">
                                {% for income in totalIncome %}
                                    {{ income|formatCurrency }}
                                {% else %}
                                    {{ 0|formatCurrency }}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-warning text-white avatar">
                              {{ icon('file-text-o') }}
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium">
                                {{ totalQuotes }} {{ 'dashboard.pending_quotes'|trans }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-danger text-white avatar">
                              {{ icon('file-text-o') }}
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium">
                                {{ totalInvoices }} {{ 'dashboard.outstanding_invoices'|trans }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="col-sm-3 d-none d-md-block">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                {{ icon('list') }} {{ 'dashboard.quick_nav.title'|trans }}
            </h3>
        </div>
        <div class="list-group list-group-flush">
            <a href="{{ path('_clients_index') }}" class="list-group-item list-group-item-action">
                {{ icon('group') }} {{ 'dashboard.quick_nav.clients'|trans }}
            </a>
            <a href="{{ path('_quotes_index') }}" class="list-group-item list-group-item-action">
                {{ icon('file-text-o') }} {{ 'dashboard.quick_nav.quotes'|trans }}
            </a>
            <a href="{{ path('_invoices_index') }}" class="list-group-item list-group-item-action">
                {{ icon('file-text-o') }} {{ 'dashboard.quick_nav.invoices'|trans }}
            </a>
            <a href="{{ path('_profile') }}" class="list-group-item list-group-item-action">
                {{ icon('user') }} {{ 'dashboard.quick_nav.profile'|trans }}
            </a>
            <a href="{{ path('_settings') }}" class="list-group-item list-group-item-action">
                {{ icon('cog') }} {{ 'dashboard.quick_nav.settings'|trans }}
            </a>
        </div>
    </div>
</div>
