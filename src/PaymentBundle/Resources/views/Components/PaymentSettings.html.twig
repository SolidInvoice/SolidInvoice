<div {{ attributes }}>
    <twig:Ui:Card>
        <twig:block name="header">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h3 class="card-title mb-1 d-flex align-items-center gap-2">
                        {{ ux_icon(gatewayInfo.icon, {width: 20, height: 20, class: 'text-primary'}) }}
                        {{ paymentMethod.name|default(gatewayInfo.displayName|trans) }}
                    </h3>
                    <p class="text-muted small mb-0">
                        {{ gatewayInfo.tagline|trans }}
                    </p>
                </div>
                <a href="{{ path('_payment_settings_index') }}"
                   class="btn btn-ghost btn-icon"
                   aria-label="{{ 'Close'|trans }}">
                    {{ ux_icon('tabler:x', {width: 20, height: 20}) }}
                </a>
            </div>
        </twig:block>

        {# About this gateway: what it is, which variant to pick, and where to get the keys #}
        {% if gatewayInfo.hasGuidance %}
            <div class="alert alert-info payment-gateway-about" role="note">
                <div class="d-flex gap-2">
                    <div class="flex-shrink-0">
                        {{ ux_icon('tabler:info-circle', {width: 20, height: 20}) }}
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <h4 class="alert-title">{{ 'payment.gateway.about.title'|trans }}</h4>
                        {% if gatewayInfo.overview %}
                            <p class="mb-0">{{ gatewayInfo.overview|trans }}</p>
                        {% endif %}
                        {% if gatewayInfo.comparison %}
                            <details class="mt-2 payment-gateway-compare">
                                <summary class="fw-bold">{{ 'payment.gateway.compare.title'|trans }}</summary>
                                <p class="mb-0 mt-1">{{ gatewayInfo.comparison|trans }}</p>
                            </details>
                        {% endif %}
                        {% if gatewayInfo.setupUrl %}
                            <a href="{{ gatewayInfo.setupUrl }}"
                               class="btn btn-sm btn-outline-primary mt-3"
                               target="_blank"
                               rel="noopener noreferrer">
                                {{ ux_icon('tabler:external-link', {width: 14, height: 14}) }}
                                {{ (gatewayInfo.setupUrlLabel ?? 'payment.gateway.setup.default_label')|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        {{ form_start(form, {
            attr: {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
            {# Details: how this method is identified inside SolidInvoice #}
            <section class="mb-4">
                <h4 class="d-flex align-items-center gap-2 mb-1">
                    {{ ux_icon('tabler:tag', {width: 18, height: 18, class: 'text-muted'}) }}
                    {{ 'payment.gateway.section.details.title'|trans }}
                </h4>
                <p class="text-muted small mb-3">{{ 'payment.gateway.section.details.subtitle'|trans }}</p>

                {{ form_row(form.name) }}
                {{ form_row(form.enabled) }}
                {% if form.internal is defined %}
                    {{ form_row(form.internal) }}
                {% endif %}
            </section>

            {# Credentials: the gateway-specific keys / API details #}
            {% if form.config is defined %}
                <section class="mb-4">
                    <h4 class="d-flex align-items-center gap-2 mb-1">
                        {{ ux_icon('tabler:key', {width: 18, height: 18, class: 'text-muted'}) }}
                        {{ 'payment.gateway.section.credentials.title'|trans }}
                    </h4>
                    <p class="text-muted small mb-3">{{ 'payment.gateway.section.credentials.subtitle'|trans }}</p>

                    {{ form_widget(form.config) }}
                </section>
            {% endif %}

            {{ form_rest(form) }}
        {{ form_end(form) }}

        <twig:block name="footer">
            <div class="d-flex justify-content-between align-items-center gap-3">
                {% if paymentMethod.id is not empty %}
                    <button type="button"
                            class="btn btn-outline-danger"
                            data-action="live#action"
                            data-live-action-param="showDeleteConfirmation"
                            aria-label="{{ 'Delete payment method'|trans }}">
                        {{ ux_icon('tabler:trash', {width: 18, height: 18}) }}
                        {{ 'Delete'|trans }}
                    </button>
                {% else %}
                    <a href="{{ path('_payment_settings_index') }}"
                       class="btn btn-ghost">
                        {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                        {{ 'Close'|trans }}
                    </a>
                {% endif %}
                <button type="submit"
                        class="btn btn-primary btn-save"
                        data-action="live#action"
                        data-live-action-param="save"
                        data-loading="addAttribute(disabled)"
                        aria-label="{{ 'Save payment method'|trans }}">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                    {{ 'Save Payment Method'|trans }}
                </button>
            </div>
        </twig:block>
    </twig:Ui:Card>

    {# Delete Confirmation Nested Modal #}
    {% if showDeleteConfirmation %}
        <div class="delete-confirmation-backdrop"
             role="presentation"
             aria-hidden="true"
             data-action="click->live#action"
             data-live-action-param="cancelDelete">
        </div>
        <div class="delete-confirmation-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="delete-modal-title">
            <div class="delete-confirmation-container">
                <div class="delete-confirmation-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="delete-icon-wrapper">
                            {{ ux_icon('tabler:alert-triangle', {width: 24, height: 24, class: 'text-danger'}) }}
                        </div>
                        <div>
                            <h4 id="delete-modal-title" class="mb-1">{{ 'Delete Payment Method'|trans }}</h4>
                            <p class="text-muted small mb-0">{{ 'This action cannot be undone'|trans }}</p>
                        </div>
                    </div>
                </div>
                <div class="delete-confirmation-body">
                    <p class="mb-0">
                        {{ 'Are you sure you want to delete'|trans }} <strong>{{ paymentMethod.name }}</strong>?
                        {{ 'This will remove the payment method and cannot be reversed.'|trans }}
                    </p>
                </div>
                <div class="delete-confirmation-footer">
                    <button type="button"
                            class="btn btn-ghost"
                            data-action="live#action"
                            data-live-action-param="cancelDelete">
                        {{ 'Cancel'|trans }}
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            data-action="live#action"
                            data-live-action-param="confirmDelete"
                            data-loading="addAttribute(disabled)">
                        {{ ux_icon('tabler:trash', {width: 16, height: 16}) }}
                        {{ 'Delete Payment Method'|trans }}
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
