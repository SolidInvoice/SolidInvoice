{% macro gateway_card(gateway) %}
    <div class="gateway-card {{ gateway.isConfigured ? 'is-configured' : '' }} {{ gateway.name == 'custom' ? 'is-custom-gateway' : '' }}"
         data-gateway="{{ gateway.name }}">
        <div class="gateway-card-body">
            <div class="d-flex align-items-start gap-3">
                <div class="gateway-icon">
                    {{ ux_icon(gateway.icon, {width: 24, height: 24}) }}
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h6 class="mb-0">{{ gateway.displayName }}</h6>
                        {% if gateway.recommended %}
                            <span class="badge bg-primary-lt badge-sm">
                                {{ 'payment.gateway.badge.recommended'|trans }}
                            </span>
                        {% elseif gateway.advanced %}
                            <span class="badge bg-secondary-lt badge-sm">
                                {{ 'payment.gateway.badge.advanced'|trans }}
                            </span>
                        {% endif %}
                        {% if gateway.isConfigured %}
                            <span class="badge bg-success-lt badge-sm">
                                {{ ux_icon('tabler:check', {width: 12, height: 12}) }}
                                <span class="visually-hidden">{{ 'payment.marketplace.badge.configured'|trans }}</span>
                            </span>
                        {% endif %}
                    </div>
                    <p class="text-muted small mb-2">{{ gateway.tagline }}</p>
                    <a href="{{ path('_payment_settings_index', {selectedGateway: gateway.name}) }}"
                       class="btn btn-sm btn-outline-primary">
                        {% if gateway.isConfigured %}
                            {{ ux_icon('tabler:edit', {width: 14, height: 14}) }}
                            {{ 'action.edit'|trans }}
                        {% else %}
                            {{ ux_icon('tabler:plus', {width: 14, height: 14}) }}
                            {{ 'payment.marketplace.action.configure'|trans }}
                        {% endif %}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

<div class="payment-marketplace" {{ attributes }}>
    {% include "@SolidInvoiceCore/flash.html.twig" %}

    {# Mobile Tabs #}
    <ul class="nav nav-tabs d-md-none mb-4" role="tablist">
        <li class="nav-item">
            <a href="{{ path('_payment_settings_index', {view: 'marketplace'}) }}"
               class="nav-link{{ view == 'marketplace' ? ' active' : '' }}"
               {% if view == 'marketplace' %}aria-current="page"{% endif %}>
                <span class="nav-link-icon">
                    {{ ux_icon('tabler:apps', {width: 16, height: 16}) }}
                </span>
                <span>{{ 'payment.marketplace.tab.marketplace'|trans }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('_payment_settings_index', {view: 'active'}) }}"
               class="nav-link{{ view == 'active' ? ' active' : '' }}"
               {% if view == 'active' %}aria-current="page"{% endif %}>
                <span class="nav-link-icon">
                    {{ ux_icon('tabler:list-check', {width: 16, height: 16}) }}
                </span>
                <span>{{ 'payment.marketplace.tab.active'|trans }} <span class="badge bg-secondary-lt ms-1">{{ activeMethods|length }}</span></span>
            </a>
        </li>
    </ul>

    {# Desktop Split View #}
    <div class="row g-4">
        {# Left Panel: Gateway Marketplace #}
        <div class="col-md-5 col-lg-4 {{ view == 'active' ? 'd-none d-md-block' : '' }}">
            <div class="marketplace-panel">
                <div class="marketplace-header mb-4">
                    <h5 class="mb-2 d-flex align-items-center gap-2">
                        {{ ux_icon('tabler:apps', {width: 20, height: 20, class: 'text-primary'}) }}
                        {{ 'payment.marketplace.gateways.title'|trans }}
                    </h5>
                    <p class="text-muted small mb-3">
                        {{ 'payment.gateway.marketplace.subtitle'|trans }}
                    </p>

                    {# Search Input #}
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            {{ ux_icon('tabler:search', {width: 18, height: 18}) }}
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="{{ 'payment.marketplace.search.placeholder'|trans }}"
                               data-model="searchQuery"
                               aria-label="{{ 'payment.marketplace.search.aria'|trans }}">
                        {% if searchQuery %}
                            <button type="button"
                                    class="btn btn-ghost btn-icon position-absolute end-0 top-50 translate-middle-y marketplace-search-clear"
                                    data-action="live#action"
                                    data-live-action-param="clearSearch"
                                    aria-label="{{ 'payment.marketplace.search.clear'|trans }}">
                                {{ ux_icon('tabler:x', {width: 16, height: 16}) }}
                            </button>
                        {% endif %}
                    </div>
                </div>

                {# Grouped Gateway Cards #}
                {% if filteredGateways|length > 0 %}
                    {# Online gateways #}
                    {% if gatewayGroups.online|length > 0 %}
                        <div class="gateway-group mb-4">
                            <div class="gateway-group-header mb-2">
                                <h6 class="text-uppercase text-muted small fw-bold mb-1">{{ 'payment.gateway.section.online.title'|trans }}</h6>
                                <p class="text-muted small mb-0">{{ 'payment.gateway.section.online.subtitle'|trans }}</p>
                            </div>
                            <div class="gateway-grid">
                                {% for gateway in gatewayGroups.online %}
                                    {{ _self.gateway_card(gateway) }}
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# Offline / manual methods #}
                    {% if gatewayGroups.offline|length > 0 %}
                        <div class="gateway-group mb-4">
                            <div class="gateway-group-header mb-2">
                                <h6 class="text-uppercase text-muted small fw-bold mb-1">{{ 'payment.gateway.section.offline.title'|trans }}</h6>
                                <p class="text-muted small mb-0">{{ 'payment.gateway.section.offline.subtitle'|trans }}</p>
                            </div>
                            <div class="gateway-grid">
                                {% for gateway in gatewayGroups.offline %}
                                    {{ _self.gateway_card(gateway) }}
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# Legacy / advanced processors, tucked away #}
                    {% if gatewayGroups.more|length > 0 %}
                        <details class="gateway-group gateway-group--more"{{ searchQuery ? ' open' : '' }}>
                            <summary class="gateway-group-header mb-2">
                                <h6 class="text-uppercase text-muted small fw-bold mb-1 d-inline-flex align-items-center gap-1">
                                    {{ 'payment.gateway.section.more.title'|trans }}
                                    <span class="badge bg-secondary-lt badge-sm">{{ gatewayGroups.more|length }}</span>
                                </h6>
                                <p class="text-muted small mb-0">{{ 'payment.gateway.section.more.subtitle'|trans }}</p>
                            </summary>
                            <div class="gateway-grid mt-2">
                                {% for gateway in gatewayGroups.more %}
                                    {{ _self.gateway_card(gateway) }}
                                {% endfor %}
                            </div>
                        </details>
                    {% endif %}
                {% else %}
                    <div class="empty">
                        <div class="empty-icon">
                            {{ ux_icon('tabler:search-off', {width: 48, height: 48}) }}
                        </div>
                        <p class="empty-title">{{ 'payment.marketplace.empty.no_gateways'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Right Panel: Active Methods List (Always Visible) #}
        <div class="col-md-7 col-lg-8 {{ view == 'marketplace' ? 'd-none d-md-block' : '' }}">
            {# Active Methods List #}
            <div class="active-methods-panel">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h5 class="mb-0 d-flex align-items-center gap-2">
                            {{ ux_icon('tabler:list-check', {width: 20, height: 20, class: 'text-primary'}) }}
                            {{ 'payment.marketplace.active.title'|trans }}
                        </h5>
                        <span class="badge bg-secondary-lt">{{ activeMethods|length }}</span>
                    </div>

                    {% if activeMethods|length > 0 %}
                        <div class="active-methods-list">
                            {% for method in activeMethods %}
                                <div class="card active-method-card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start justify-content-between gap-3">
                                            <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">
                                                <div class="payment-method-icon">
                                                    {{ ux_icon(this.iconFor(method.factoryName), {width: 24, height: 24}) }}
                                                </div>
                                                <div class="flex-grow-1 min-w-0">
                                                    <h6 class="mb-2">{{ method.name }}</h6>
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="badge {{ method.enabled ? 'bg-success-lt' : 'bg-secondary-lt' }}">
                                                            {{ method.enabled ? 'payment.marketplace.badge.enabled'|trans : 'payment.marketplace.badge.disabled'|trans }}
                                                        </span>
                                                        {% if method.config.sandbox|default(false) %}
                                                            <span class="badge bg-warning-lt">
                                                                {{ ux_icon('tabler:flask', {width: 12, height: 12}) }}
                                                                {{ 'payment.marketplace.badge.test_mode'|trans }}
                                                            </span>
                                                        {% endif %}
                                                        {% if method.isInternal %}
                                                            <span class="badge bg-info-lt">
                                                                {{ 'payment.method.offline'|trans }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 flex-shrink-0">
                                                <a href="{{ path('_payment_settings_index', {selectedGateway: method.gatewayName}) }}"
                                                   class="btn btn-outline-secondary btn-sm"
                                                   aria-label="{{ 'payment.marketplace.edit_aria'|trans({'%name%': method.name}) }}">
                                                    {{ ux_icon('tabler:edit', {width: 16, height: 16}) }}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty">
                            <div class="empty-icon">
                                {{ ux_icon('tabler:credit-card-off', {width: 64, height: 64}) }}
                            </div>
                            <p class="empty-title">{{ 'payment.marketplace.empty.no_methods'|trans }}</p>
                            <p class="empty-subtitle text-secondary">
                                {{ 'payment.marketplace.empty.no_methods_hint'|trans }}
                            </p>
                            <div class="empty-action">
                                <a href="{{ path('_payment_settings_index', {view: 'marketplace'}) }}"
                                   class="btn btn-primary">
                                    {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
                                    {{ 'payment.marketplace.empty.browse'|trans }}
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </div>
        </div>
    </div>

    {# Configuration Modal #}
    {% if selectedGateway is not empty %}
        <div class="payment-modal-backdrop"
             role="presentation"
             data-action="click->live#action"
             data-live-action-param="closeModal">
        </div>
        <div class="payment-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="payment-modal-title"
             data-controller="payment-modal">
            <div class="payment-modal-container">
                <div class="payment-modal-header">
                    <h3 id="payment-modal-title" class="payment-modal-title">
                        {{ 'payment.marketplace.modal.title'|trans }}
                    </h3>
                    <a href="{{ path('_payment_settings_index') }}"
                       class="btn btn-ghost btn-icon payment-modal-close"
                       aria-label="{{ 'action.close'|trans }}"
                       title="{{ 'payment.marketplace.modal.close_title'|trans }}">
                        {{ ux_icon('tabler:x', {width: 20, height: 20}) }}
                    </a>
                </div>
                <div class="payment-modal-body">
                    <twig:PaymentSettings method="{{ selectedGateway }}" />
                </div>
            </div>
        </div>
    {% endif %}
</div>
