{# @var ui_layout_condensed string #}

{% extends ui_layout_condensed %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
{% endblock stylesheets %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock javascripts %}

{% block brand %}
    <div class="company-page-logo">
        {{ app_logo('48', showDefault: true, showOnlyAppIcon: true) }}
    </div>
    <div class="company-page-brand">
        <h1 class="h3 mb-0">{{ app_name }}</h1>
    </div>
{% endblock brand %}
