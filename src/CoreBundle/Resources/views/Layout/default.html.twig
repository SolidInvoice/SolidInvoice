{% extends '@SolidInvoiceCore/Layout/base.html.twig' %}

{% block navbar_actions %}
    {% include "@SolidInvoiceCore/Menu/search.html.twig" with {"title" : block('title') ?? '', "header_content" : header_content|default('')} %}
{% endblock navbar_actions %}

{% block user_menu %}
    {% include "@SolidInvoiceCore/Menu/top.html.twig" with {"title" : block('title') ?? '', "header_content" : header_content|default('')} %}
    {{ parent() }}
{% endblock user_menu %}

{% block user_menu_items %}
    <a href="{{ path('_profile') }}" class="dropdown-item">
        {{ ux_icon('tabler:user', {width: 16, height: 16}) }}
        {{ 'layout.profile'|trans }}
    </a>
    <div class="dropdown-divider"></div>
    <a href="{{ path('_api_keys_index') }}" class="dropdown-item">
        {{ ux_icon('tabler:lock', {width: 16, height: 16}) }}
        {{ 'layout.api_keys'|trans }}
    </a>
    <a href="{{ path('_export_list') }}" class="dropdown-item">
        {{ ux_icon('tabler:database-export', {width: 16, height: 16}) }}
        {{ 'layout.data_export'|trans }}
    </a>
    <a href="{{ feedback_form_url }}" class="dropdown-item" target="_blank" rel="noopener">
        {{ ux_icon('tabler:message-circle', {width: 16, height: 16}) }}
        {{ 'layout.feedback'|trans }}
    </a>
    <div class="dropdown-divider"></div>
    <twig:Ui:Security:LogoutLink />
{% endblock user_menu_items %}

{% block footer %}
    <footer class="footer footer-transparent d-print-none bg-white">
        <div class="container-xl">
            <div class="row text-center align-items-center flex-row-reverse">
                <div class="col-lg-auto ms-lg-auto">
                    <nav>
                        <ul class="list-inline list-inline-dots mb-0">
                            <li class="list-inline-item">
                                <a href="{{ feedback_form_url }}" class="link-secondary" target="_blank" rel="noopener">{{ 'layout.feedback'|trans }}</a>
                            </li>
                            {% if affiliate_program().enabled %}
                                <li class="list-inline-item">
                                    <a href="{{ path('_profile_affiliate', {source: 'footer'}) }}" class="text-secondary">{{ 'affiliate.footer_link'|trans }}</a>
                                </li>
                            {% endif %}
                            <li class="list-inline-item">
                                <a href="https://solidinvoice.co/docs" target="_blank" class="link-secondary" rel="noopener">{{ 'layout.documentation'|trans }}</a>
                            </li>
                            {% if not toggle('saas_enabled') %}
                                <li class="list-inline-item">
                                    <a href="https://github.com/sponsors/solidinvoice" target="_blank" class="link-secondary" rel="noopener">
                                        {{ ux_icon('tabler:heart', {width: 16, height: 16, class: 'icon text-pink icon-inline'}) }}
                                        {{ 'layout.sponsor'|trans }}
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                </div>
                <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                    <ul class="list-inline list-inline-dots mb-0">
                        <li class="list-inline-item">
                            {{ "layout.powered_by"|trans }} <a href="https://solidinvoice.co">{{ constant('SolidInvoice\\CoreBundle\\SolidInvoiceCoreBundle::APP_NAME') }}</a>{% if app_version %} - {{ app_version }}{% endif %}
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
{% endblock footer %}

{% block sidebar_brand %}
    <div class="navbar-brand">
        <a href="{{ path('_dashboard') }}" aria-label="{{ company_name() }}" class="d-flex align-items-center text-decoration-none link-white">
            {{ app_logo(showDefault: true) }}
            <small class="d-flex flex-column text-wrap lh-sm text-start">
                {{ company_name() }}
            </small>
        </a>
    </div>
{% endblock sidebar_brand %}
