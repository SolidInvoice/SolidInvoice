{% extends "@SolidInvoiceCore/Layout/default_no_nav.html.twig" %}

{% block title %}Select Company{% endblock title %}

{% block content %}

    <div class="row">
        <div class="col-md-6 offset-3">
            <div class="card">
                <div class="card-header with-border">
                    <h3 class="card-title" id="install-title">
                        {{ 'Choose Company'|trans }}
                    </h3>
                </div>
                <div class="list-group list-group-flush list-group-hoverable">
                    {% for company in companies %}
                        <a href="{{ path('_switch_company', {'id': company.id}) }}" class="list-group-item list-group-item-action">
                            {{ app_logo('50', company) }}
                            {{ company }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
