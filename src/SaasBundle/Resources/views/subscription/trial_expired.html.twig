{% extends '@SolidInvoiceCore/Layout/default_no_nav.html.twig' %}

{% block content %}
    {% set availableCompanies = app.user.companies|filter(v => v.id != company_id()) %}

    <div class="subscription-page subscription-expired-page">
        <div class="subscription-container">
            {# Hero Icon #}
            <div class="subscription-icon subscription-icon-warning">
                {{ ux_icon('tabler:clock-hour-4', {width: 32, height: 32}) }}
            </div>

            {# Headline #}
            <h1 class="subscription-title">{{ 'saas.trial_expired.title'|trans }}</h1>
            <p class="subscription-subtitle">
                {{ 'saas.trial_expired.subtitle'|trans({'%days%': subscription.startDate.diff(subscription.endDate).days|abs, '%date%': subscription.endDate|date('F j, Y'), '%price%': subscription.plan.price|formatCurrency('USD')}) }}
            </p>

            {# Benefits Reminder #}
            <div class="subscription-benefits">
                <h3>{{ 'saas.trial_expired.features_heading'|trans }}</h3>
                <ul>
                    <li>
                        {{ ux_icon('tabler:check', {width: 20, height: 20}) }}
                        {{ 'saas.trial_expired.feature_invoices'|trans }}
                    </li>
                    <li>
                        {{ ux_icon('tabler:check', {width: 20, height: 20}) }}
                        {{ 'saas.trial_expired.feature_payments'|trans }}
                    </li>
                    <li>
                        {{ ux_icon('tabler:check', {width: 20, height: 20}) }}
                        {{ 'saas.trial_expired.feature_clients'|trans }}
                    </li>
                    <li>
                        {{ ux_icon('tabler:check', {width: 20, height: 20}) }}
                        {{ 'saas.trial_expired.feature_reports'|trans }}
                    </li>
                    <li>
                        {{ ux_icon('tabler:check', {width: 20, height: 20}) }}
                        {{ 'saas.trial_expired.feature_recurring'|trans }}
                    </li>
                </ul>
            </div>

            {# Limited-time promo to entice activation #}
            {% if coupon_code|default('') is not empty %}
                <div class="card subscription-coupon mb-4 text-start">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="subscription-promo-icon text-primary">
                                {{ ux_icon('tabler:gift', {width: 32, height: 32}) }}
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-3 mb-1">
                                    {{ 'saas.trial_expired.promo_heading'|trans({'%percent%': coupon_percent}) }}
                                </div>
                                <div class="text-subtle">
                                    {{ 'saas.trial_expired.promo_message'|trans({'%code%': coupon_code|e, '%percent%': coupon_percent})|raw }}
                                </div>
                            </div>
                            <div class="subscription-promo-code text-center">
                                <div class="text-uppercase text-subtle small mb-1">{{ 'saas.trial_expired.promo_code'|trans }}</div>
                                <span class="badge fs-2 px-3 py-2 font-monospace">{{ coupon_code }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Primary CTA #}
            <div class="subscription-actions">
                <a href="{{ path('saas_subscription_plans') }}" class="btn btn-primary btn-lg">
                    {{ ux_icon('tabler:credit-card', {width: 20, height: 20}) }}
                    {% if coupon_code|default('') is not empty %}
                        {{ 'saas.trial_expired.activate_save'|trans({'%percent%': coupon_percent}) }}
                    {% else %}
                        {{ 'saas.trial_expired.activate'|trans }}
                    {% endif %}
                </a>
                <a href="https://solidinvoice.co/contact" class="btn btn-ghost" target="_blank" rel="external noreferrer noopener">
                    {{ ux_icon('tabler:help', {width: 18, height: 18}) }} {{ 'saas.action.contact_support'|trans }}
                </a>
            </div>

            {# Info Alert for Multiple Companies #}
            {% if availableCompanies|length > 0 %}
                <twig:Ui:Alert type="info" class="mt-4 text-start">
                    <div class="d-flex align-items-center gap-2">
                        {{ ux_icon('tabler:building', {width: 20, height: 20}) }}
                        <div>
                            {{ 'saas.company.access_other'|trans }}
                            <a href="{{ path('_switch_company', {'id': availableCompanies|first.id}) }}" class="alert-link">
                                {{ 'saas.company.switch_to'|trans({'%company%': availableCompanies|first}) }}
                            </a>
                        </div>
                    </div>
                </twig:Ui:Alert>
            {% endif %}
        </div>
    </div>
{% endblock content %}
