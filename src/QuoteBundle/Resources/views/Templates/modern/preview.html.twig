{# Modern Minimal preview #}
{% set currency = quote.client.currency %}

<div class="quote-template quote-template-modern" style="background: #ffffff;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5">
            <div class="mb-5">
                {% if app_logo() is not empty %}<div class="mb-3">{{ app_logo(48) }}</div>{% endif %}
                <div class="text-muted text-uppercase mb-2" style="font-size: 12px; letter-spacing: 4px;">{{ 'quote.pdf.title'|trans }} · #{{ quote.quoteId }}</div>
                <div class="text-muted text-uppercase mb-2" style="font-size: 13px; letter-spacing: 2px;">
                    {{ 'quote.pdf.total'|trans }}
                </div>
                <div class="display-3 fw-bold text-dark mb-0" style="line-height: 1;">
                    {{ quote.total|formatCurrency(currency) }}
                </div>
            </div>

            <div class="row mb-5 pt-4 border-top">
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase mb-1" style="letter-spacing: 1px;">{{ 'quote.from'|trans }}</div>
                    <div class="fw-bold">{{ company_name() }}</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase mb-1" style="letter-spacing: 1px;">{{ 'quote.to'|trans }}</div>
                    <div class="fw-bold">{{ quote.client }}</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase mb-1" style="letter-spacing: 1px;">{{ 'quote.pdf.date'|trans }}</div>
                    <div>{{ quote.created|date('F j, Y') }}</div>
                    {% if quote.due %}
                        <div class="text-muted small text-uppercase mb-1 mt-2" style="letter-spacing: 1px;">{{ 'quote.pdf.valid_until'|trans }}</div>
                        <div>{{ quote.due|date('F j, Y') }}</div>
                    {% endif %}
                </div>
            </div>

            <table class="table table-borderless">
                <thead>
                    <tr class="border-bottom">
                        <th class="text-muted small text-uppercase" style="letter-spacing: 1px;">{{ 'quote.item.heading.description'|trans }}</th>
                        <th class="text-muted small text-uppercase text-end" style="letter-spacing: 1px;">{{ 'quote.item.heading.qty'|trans }}</th>
                        <th class="text-muted small text-uppercase text-end" style="letter-spacing: 1px;">{{ 'quote.item.heading.price'|trans }}</th>
                        <th class="text-muted small text-uppercase text-end" style="letter-spacing: 1px;">{{ 'quote.item.heading.total'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in quote.lines %}
                        <tr class="border-bottom">
                            <td class="py-3">{{ line.description|nl2br }}</td>
                            <td class="py-3 text-end">{{ line.qty }}</td>
                            <td class="py-3 text-end">{{ line.price|formatCurrency(currency) }}</td>
                            <td class="py-3 text-end fw-bold">{{ line.total|formatCurrency(currency) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="row justify-content-end mt-4">
                <div class="col-md-5">
                    <div class="d-flex justify-content-between mb-2"><span>{{ 'quote.subtotal'|trans }}</span><span>{{ quote.baseTotal|formatCurrency(currency) }}</span></div>
                    {% if quote.tax.positive %}<div class="d-flex justify-content-between mb-2 text-muted"><span>{{ 'quote.tax'|trans }}</span><span>{{ quote.tax|formatCurrency(currency) }}</span></div>{% endif %}
                    {% if quote.discount.type is not empty %}<div class="d-flex justify-content-between mb-2 text-muted"><span>{{ 'quote.discount'|trans }}</span><span>-{{ discount(quote)|formatCurrency(currency) }}</span></div>{% endif %}
                    <div class="d-flex justify-content-between border-top pt-3 mt-3">
                        <span class="fw-bold fs-5">{{ 'quote.total'|trans }}</span>
                        <span class="fw-bold fs-3">{{ quote.total|formatCurrency(currency) }}</span>
                    </div>
                </div>
            </div>

            {% if quote.terms is not empty %}<div class="mt-5 text-muted small">{{ quote.terms|nl2br }}</div>{% endif %}
        </div>
    </div>
</div>
