{#
 # Modern Minimal — calm, confident. Big quote-total hero, lots of whitespace.
 #}
{% extends '@SolidInvoiceQuote/Templates/_pdf_base.html.twig' %}
{% import '@SolidInvoiceQuote/Templates/_macros.html.twig' as q %}

{% set currency = quote.client.currency %}

{% block extra_styles %}
    body { font-family: helvetica, Arial, sans-serif; color: #1e293b; }
{% endblock %}

{% block body %}
<div style="padding: 30mm 0 12mm 0;">
    {% if setting('system/company/logo') is not empty %}
        <div style="margin-bottom: 16px;">{{ app_logo(50) }}</div>
    {% endif %}
    <div style="font-size: 9pt; color: #94a3b8; text-transform: uppercase; letter-spacing: 4px; margin-bottom: 8px;">
        {{ 'quote.pdf.title'|trans }} · #{{ quote.quoteId }}
    </div>
    <div style="font-size: 11pt; color: #64748b; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px;">
        {{ 'quote.pdf.total'|trans }}
    </div>
    <div style="font-size: 36pt; font-weight: bold; color: #0f172a; line-height: 1.0;">
        {{ quote.total|formatCurrency(currency) }}
    </div>
</div>

<table cellpadding="0" cellspacing="0" style="width: 100%; margin-bottom: 28px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <tr>
        <td style="width: 33%; vertical-align: top;">{{ q.from_block() }}</td>
        <td style="width: 33%; vertical-align: top; padding: 0 12px;">{{ q.bill_to_block(quote) }}</td>
        <td style="width: 34%; vertical-align: top;">
            {{ q.meta_pair('quote.pdf.date'|trans, quote.created|date('F j, Y')) }}
            {% if quote.due %}
                {{ q.meta_pair('quote.pdf.valid_until'|trans, quote.due|date('F j, Y')) }}
                <div style="margin-top: 2px;">{{ q.validity_indicator(quote) }}</div>
            {% endif %}
        </td>
    </tr>
</table>

<table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 28px;">
    <thead>
        <tr>
            <th style="padding: 12px 0; font-size: 8pt; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; text-align: left; border-bottom: 1px solid #e2e8f0;">{{ 'quote.item.heading.description'|trans }}</th>
            <th style="padding: 12px 0; font-size: 8pt; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; text-align: right; border-bottom: 1px solid #e2e8f0;">{{ 'quote.item.heading.qty'|trans }}</th>
            <th style="padding: 12px 0; font-size: 8pt; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; text-align: right; border-bottom: 1px solid #e2e8f0;">{{ 'quote.item.heading.price'|trans }}</th>
            <th style="padding: 12px 0; font-size: 8pt; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; text-align: right; border-bottom: 1px solid #e2e8f0;">{{ 'quote.item.heading.total'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for line in quote.lines %}
            <tr>
                <td style="padding: 16px 0; font-size: 10pt; color: #1e293b; border-bottom: 1px solid #f1f5f9;">{{ line.description|nl2br }}</td>
                <td style="padding: 16px 0; font-size: 10pt; color: #1e293b; border-bottom: 1px solid #f1f5f9; text-align: right;">{{ line.qty }}</td>
                <td style="padding: 16px 0; font-size: 10pt; color: #1e293b; border-bottom: 1px solid #f1f5f9; text-align: right;">{{ line.price|formatCurrency(currency) }}</td>
                <td style="padding: 16px 0; font-size: 10pt; color: #1e293b; border-bottom: 1px solid #f1f5f9; text-align: right; font-weight: 600;">{{ line.total|formatCurrency(currency) }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{{ q.totals_block(quote, currency, {totalBg: '#ffffff', totalColor: '#0f172a'}) }}
{{ q.terms_block(quote) }}
{% endblock %}
