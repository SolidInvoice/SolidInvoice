<div {{ attributes }} class="row row-deck row-cards mb-4">
    {# Active Tokens #}
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary text-white avatar">
                            {{ ux_icon('tabler:key', {width: 24, height: 24}) }}
                        </span>
                    </div>
                    <div class="col">
                        <div class="fw-medium">
                            {{ stats.activeTokens }}
                        </div>
                        <div class="text-secondary">
                            {{ 'profile.api.stats.active_tokens'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# API Calls This Month #}
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-info text-white avatar">
                            {{ ux_icon('tabler:api', {width: 24, height: 24}) }}
                        </span>
                    </div>
                    <div class="col">
                        <div class="fw-medium">
                            {{ stats.apiCallsThisMonth|number_format }}
                        </div>
                        <div class="text-secondary">
                            {{ 'profile.api.stats.calls_month'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Last Activity #}
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-success text-white avatar">
                            {{ ux_icon('tabler:clock', {width: 24, height: 24}) }}
                        </span>
                    </div>
                    <div class="col">
                        <div class="fw-medium">
                            {% if stats.lastActivity %}
                                {{ stats.lastActivity|date('d M Y') }}
                            {% else %}
                                {{ 'profile.api.tokens.used.never'|trans }}
                            {% endif %}
                        </div>
                        <div class="text-secondary">
                            {{ 'profile.api.stats.last_activity'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Most Used Token #}
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-warning text-white avatar">
                            {{ ux_icon('tabler:star', {width: 24, height: 24}) }}
                        </span>
                    </div>
                    <div class="col">
                        <div class="fw-medium">
                            {{ stats.mostUsedToken|default('-')|u.truncate(18, '...') }}
                        </div>
                        <div class="text-secondary">
                            {{ 'profile.api.stats.most_used'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
