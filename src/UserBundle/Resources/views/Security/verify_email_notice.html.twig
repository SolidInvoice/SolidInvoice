{% extends '@SolidInvoiceCore/Layout/base.html.twig' %}

{% block page_title %}{{ app_name }} - {{ "Verify your email"|trans }}{% endblock page_title %}

{% block body %}
    <div class="page page-center">
        <div class="container container-tight py-4">
            <div class="text-center mb-4">
                <span class="navbar-brand navbar-brand-autodark">{{ app_name }}</span>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">
                        {{ message|trans }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card card-md">
                <div class="card-body text-center">
                    <div class="mb-3">
                        {{ ux_icon('tabler:mail-forward', {width: 48, height: 48, class: 'text-primary'}) }}
                    </div>
                    <h1 class="h2 mb-3">{{ "Please verify your email address"|trans }}</h1>
                    <p class="text-secondary mb-4">
                        {{ "We've sent a verification link to %email%. Click the link in that email to activate your account and continue."|trans({'%email%': email}) }}
                    </p>

                    <form method="post" action="{{ path('_resend_verification') }}" class="mb-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('resend_verification') }}">
                        <button type="submit" class="btn btn-primary w-100">
                            {{ "Resend verification email"|trans }}
                        </button>
                    </form>

                    <p class="text-secondary mb-0">
                        <a href="{{ path('_logout') }}">{{ "Sign out"|trans }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
