<div class="onboarding-step-card text-center">
    {# Success Animation #}
    <div class="celebration-icon mb-4">
        <div class="success-checkmark">
            {{ ux_icon('tabler:circle-check', {width: 96, height: 96, class: 'text-success'}) }}
        </div>
    </div>

    <h1 class="h1 mb-3">🎉 You're all set!</h1>
    <p class="lead text-muted mb-4">
        Your account is ready and you're good to go
    </p>

    {# Next Steps #}
    <div class="step-benefits text-start mb-4">
        <div class="d-flex align-items-start gap-2">
            {{ ux_icon('tabler:checklist', {width: 20, height: 20, class: 'text-primary mt-1'}) }}
            <div>
                <strong class="d-block mb-2">What happens next?</strong>
                <ul class="mb-0">
                    <li><strong>Dashboard:</strong> Get an overview of your business at a glance</li>
                    <li><strong>Create invoices:</strong> Professional invoices in seconds</li>
                    <li><strong>Track payments:</strong> See who owes you and who's paid</li>
                    <li><strong>Customize:</strong> Add your logo, payment methods, and more</li>
                </ul>
            </div>
        </div>
    </div>

    {# Quick Tips #}
    <div class="alert alert-info d-flex align-items-start gap-3 mb-4" role="alert">
        {{ ux_icon('tabler:bulb', {width: 20, height: 20, class: 'flex-shrink-0 mt-1'}) }}
        <div class="text-start">
            <strong>Pro tip:</strong> Add your company logo and customize your invoice template in
            Settings → Company to look more professional
        </div>
    </div>

    {{ form_start(form) }}
        <div class="d-grid gap-3">
            {{ form_widget(form.navigator.finish, {
                'label': 'Go to Dashboard',
                'attr': {'class': 'btn btn-primary btn-lg'}
            }) }}
        </div>
    {{ form_end(form) }}

    <div class="mt-4 pt-3 border-top">
        <p class="text-muted small mb-2">
            {{ ux_icon('tabler:heart', {width: 16, height: 16, class: 'text-danger'}) }}
            Thanks for choosing {{ app_name }}
        </p>
        <p class="text-muted small mb-0">
            Need help? Check out our
            <a href="https://docs.solidinvoice.co" target="_blank" rel="noopener" class="text-primary">documentation</a>
            or <a href="https://github.com/solidinvoice/solidinvoice/discussions" target="_blank" rel="noopener" class="text-primary">community forum</a>
        </p>
    </div>
</div>

<style>
    .celebration-icon {
        animation: celebrate 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    @keyframes celebrate {
        0% {
            transform: scale(0) rotate(-180deg);
            opacity: 0;
        }
        50% {
            transform: scale(1.1) rotate(10deg);
        }
        100% {
            transform: scale(1) rotate(0deg);
            opacity: 1;
        }
    }

    .success-checkmark {
        position: relative;
    }

    .success-checkmark::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(40, 167, 69, 0.1);
        animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.5;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 0.3;
        }
    }
</style>
