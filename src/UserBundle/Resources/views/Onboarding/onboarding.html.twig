{% extends '@SolidInvoiceCore/Layout/default_no_nav.html.twig' %}

{% block page_title %}{{ 'onboarding.page_title'|trans({'%app_name%': app_name}) }}{% endblock %}

{% block body %}
    <div class="onboarding-container min-vh-100">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8 col-xl-6">
                    <div class="onboarding-step-card">
                        <div class="welcome-section">
                            <div class="welcome-badge">
                                {{ ux_icon('tabler:sparkles', {width: 16, height: 16}) }}
                                {{ 'onboarding.company.welcome'|trans({'%app_name%': app_name}) }}
                            </div>
                            <div class="step-icon">
                                {{ ux_icon('tabler:building', {width: 32, height: 32}) }}
                            </div>
                            <h2 class="h2 mb-2">{{ 'onboarding.company.title'|trans }}</h2>
                            <p class="text-muted lead mb-0">{{ 'onboarding.company.description'|trans }}</p>
                        </div>

                        {{ form_start(form) }}
                            <div class="mb-4">
                                {{ form_row(form.companyName, {'attr': {'class': 'form-control form-control-lg'}}) }}
                            </div>

                            <div class="mb-4">
                                {{ form_row(form.companyCurrency, {'attr': {'class': 'form-control'}}) }}
                            </div>

                            {# Fields added by form type extensions (e.g. SaasBundle's signup question). #}
                            {{ form_rest(form) }}

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    {{ 'onboarding.company.submit'|trans }}
                                    {{ ux_icon('tabler:arrow-right', {width: 18, height: 18}) }}
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
