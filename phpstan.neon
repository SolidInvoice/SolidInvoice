includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    level: 6
    paths:
        - migrations
        - src
    bootstrapFiles:
        - vendor/autoload.php
    excludePaths:
        - src/CoreBundle/Tests/Fixtures/file.php
    symfony:
        containerXmlPath: var/cache/dev/SolidInvoice_KernelDevDebugContainer.xml
    treatPhpDocTypesAsCertain: false
