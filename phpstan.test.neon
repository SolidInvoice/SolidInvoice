includes:
    - phpstan.neon
    - phpstan-test-baseline.neon

parameters:
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    scanDirectories:
        - var/cache/test/Symfony/Config
    symfony:
        containerXmlPath: var/cache/test/SolidInvoice_KernelTestDebugContainer.xml
