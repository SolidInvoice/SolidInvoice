includes:
    - phpstan.neon
    - phpstan-test-baseline.neon

parameters:
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    # Note: the generated Symfony/Config config-builder classes no longer exist in Symfony 8,
    # so the var/cache/test/Symfony/Config scan directory was removed.
    symfony:
        containerXmlPath: var/cache/test/SolidInvoice_KernelTestDebugContainer.xml
